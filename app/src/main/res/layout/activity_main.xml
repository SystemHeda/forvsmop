<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/bg" android:padding="12dp">

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="vertical">

        <TextView android:id="@+id/status_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_name"
            android:textColor="@color/accent" android:textSize="18sp" android:paddingBottom="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/brand" android:textColor="@color/text" android:focusable="true"/>
        <Spinner android:id="@+id/brand_spinner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@color/panel"
            android:padding="8dp" android:focusable="true"/>

        <EditText android:id="@+id/url_edit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/stream_url" android:focusable="true"
            android:textColor="@color/text" android:textColorHint="@color/hint"
            android:inputType="textUri"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/play_btn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/play" android:focusable="true"/>
            <Button android:id="@+id/discover_btn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/discover" android:focusable="true"/>
        </LinearLayout>

        <ListView android:id="@+id/device_list" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:background="@color/panel" android:textColor="@color/text"/>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/player_fragment"
        android:name="ir.alamoot.plus.PlayerFragment"
        android:layout_width="0dp" android:layout_weight="2"
        android:layout_height="match_parent"/>
</LinearLayout>
